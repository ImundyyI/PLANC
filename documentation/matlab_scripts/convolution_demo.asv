clear;
close all;
clc;

% 30k samples for long period.
L = 30000;                      
F = [200, 400, 2000, 12500];
% match sample rate of system.
Fs = 48.8 * 10^3;

% samples will have 18-bit widths.
X_BITS = 18; 
FX_BITS = 18;
PLANT_SHIFT = 18;
SHAT_SHIFT = 18;
% anti-noise output will have 32-bit width.
Y_BITS = 32;
% Weights will be computed with extra bits to stop overflow.
% Because weights will likely be large values, we can just take
% the top 26-bits of the vector and sacrifice precision.
% we can expect the output of FXLMS to be 26-bits, but interally
% we store as 29-bit.
WEIGHT_TRUE_BITS = 29;
WEIGHT_OUT_BITS = 26;
% amount of 'guard bits' to extend the weights by temporarily.
WEIGHT_GUARD_BITS = 3;
% static FIR accumulator bits.
ACC_BITS = 48;
% mu will be implemented as 2^-(this value)
mu = 2^(-10);
WF = 18;


% this just clamps a value. Note that because this is 2's complement
% maximum values are 2^(b-1) - 1 and minimum is -2^(b-1)
sat  = @(v,b) max(min(v, 2^(b-1)-1), -2^(b-1)); 
% this just gets the integer and wraps it so it acts
% like a std_logic_vector. b is the number of bits, v is the value.
wrap = @(v,b) mod(v + 2^(b-1), 2^b) - 2^(b-1); 

% detect overflow based on if the value exceeds bit width (i.e carry).
overflow = @(v,b) (v > 2^(b-1) - 1) | (v < -2^(b-1));
overflow_count = 0;

% generate input signal.
x = sat(round(1000 * sin(F(4) / Fs * 2 * pi .* (1:L))), X_BITS);

