-588, -551, -380, -178, -293, -572, -486, -87, 127, 46, -90, -155, -161, -133, -88, -54, -21, 8, -18, -75, -74, -87, -220, -332, -255, -142, -163, -168, 18, 218, 209, 152, 223, 246, 169, 208, 343, 323, 98, -99, 20, 420, 700, 655, 453, 280, 230, 333, 525, 609, 381, 2, -54, 286, 514, 399, 244, 233, 281, 277, 112, -104, -18, 371, 593, 410, 123, 89, 314, 542, 585, 452, 250, 145, 169, 140, 41, 28, 105, 237, 359, 203, -278, -597, -325, 275, 498, 153, -128, -39, -115, -423, -376, -92, -72, -150, -55, 28, -2, -62, -53, 132, 254, -6, -409, -538, -369, -84, -1, -293, -563, -506, -413, -412, -246, 25, 83, -107, -310, -404, -503, -565, -382, -126, -207, -490, -493, -170, 116, 114, -32, -56, -75, -299, -447, -229, 45, -2, -177, -127, 31, -119, -532, -653, -276, 89, -4, -295, -287, -7, 104, -53, -226, -335, -419, -369, -136, 45, 10, -93, -108, 19, 241, 279, -3, -275, -308, -192, -13, 96, -34, -210, -117, 97, 72, -121, -127, 39, 91, 17, -38, -60, -50, -34, -129, -304, -367, -257, -62, 110, 188, 211, 164, -29, -181, -121, -92, -205, -203, -9, 135, 83, -33, -61, -64, -82, -17, 127, 208, 155, 53, 3, 48, 151, 121, -159, -386, -261, -12, 79, 77, 145, 374, 622, 549, 107, -294, -270, 73, 296, 244, 200, 325, 392, 271, 160, 168, 169, 155, 184, 160, 52, -39, -53, 71, 281, 273, -26, -212, -25, 253, 295, 199, 268, 541, 646, 349, -21, -53, 194, 390, 405, 378, 429, 479, 439, 388, 407, 414, 248, -57, -146, 83, 289, 335, 326, 170, -113, -157, 111, 303, 274, 294, 472, 595, 476, 199, 4, 50, 298, 483, 347, 64, 116, 491, 684, 528, 311, 194, 93, -20, -116, -186, -205, -67, 197, 314, 179, 40, -10, -146, -269, -125, 142, 229, 191, 207, 195, 104, 101, 154, 44, -141, -148, 20, 133, 44, -78, -64, -88, -263, -388, -366, -282, -186, -185, -311, -378, -266, -58, 100, 17, -331, -615, -498, -95, 122, 10, -104, -112, -187, -245, -172, -168, -249, -202, -113, -204, -410, -465, -321, -257, -442, -669, -691, -545, -402, -355, -356, -300, -222, -287, -498, -626, -495, -193, 19, 35, -24, -113, -242, -288, -205, -136, -159, -250, -384, -390, -171, 60, 75, -86, -218, -243, -278, -372, -397, -269, -75, 37, 10, -105, -224, -239, -88, 91, 64, -93, -39, 274, 484, 370, 133, 18, -26, -68, -5, 109, 83, -36, -83, -8, 157, 290, 288, 212, 90, -52, -63, 91, 284, 412, 370, 143, -19, 96, 326, 430, 408, 342, 253, 226, 389, 624, 595, 307, 133, 186, 240, 229, 302, 428, 431, 299, 169, 153, 144, 1, -98, 53, 233, 214, 135, 143, 223, 329, 386, 317, 175, 86, 123, 230, 310, 298, 158, 8, 34, 158, 155, 29, 34, 216, 284, 135, 27, 58, 41, -60, -71, -11, -73, -237, -303, -186, 36, 201, 184, 24, -129, -114, 35, 74, -24, -63, -83, -149, -130, -32, -6, -123, -300, -330, -163, -93, -261, -374, -286, -204, -240, -285, -309, -361, -396, -374, -377, -415, -317, -125, -119, -281, -390, -422, -352, -131, 56, 18, -134, -141, -10, -10, -206, -311, -188, -99, -220, -345, -294, -190, -166, -129, -42, -77, -220, -175, 63, 145, 24, -23, 44, 100, 135, 139, 81, 47, 98, 169, 206, 247, 274, 189, 52, 68, 240, 329, 257, 196, 209, 155, 24, 42, 241, 305, 137, 52, 148, 223, 213, 197, 225, 284, 345, 376, 344, 271, 234, 256, 295, 309, 239, 111, 81, 230, 365, 279, 68, -33, 34, 118, 156, 209, 163, -34, -90, 87];
% take first 1024 elements in ROM.
s = s(1:1024);          
% assumes the actual secondary path will be different.
s_plant = s / 2^PLANT_SHIFT; 
s_num = length(s);

% weightings. these are 26-bit values.
w = zeros(1, 32);            
w_num = length(w);
% stores memory elements of x samples.
x_buff = zeros(1, max(w_num, s_num));
% same but for y.
y_buff = zeros(1, s_num);
% stores history of fx.
fx = zeros(1, w_num);
% stores history of y for graphing purposes.
y = zeros(1, L);
% same for graphing error.
e_arr = zeros(1, L);

for n = 1:L

    x_buff = [x(n), x_buff(1:end-1)];
%% STATIC FIR    
    acc = sum(x_buff(1:s_num) .* s);
    acc = wrap(acc, ACC_BITS);
    % calculate fx.
    fx  = [wrap(floor(acc / 2^SHAT_SHIFT), FX_BITS), fx(1:end-1)];

    % adaptive FIR uses only the top 26 bits of the accumulator. before
    % this line they are stored as 29-bit values.
    w_out = floor(w / 2^WEIGHT_GUARD_BITS);
    % w_out = floor(w);
    % convolve weights with history of x based on 32-tap FIR filter.
    yacc = sum(x_buff(1:w_num) .* w_out);
    % shift 49-bit accumulation down by 18-bits to get values.
    y(n) = sat(floor(yacc / 2^WF), Y_BITS);
    y_buff = [y(n), y_buff(1:end-1)];

    % simulated speaker -> mic path
    ys = sum(y_buff .* s_plant);
    e = sat(round(x(n) + ys), X_BITS);
    e_arr(n) = e;

    % weight update, accumulator wraps at WA bits
    w = wrap(w - floor(e .* fx .* mu), WEIGHT_TRUE_BITS);
    % w = w - floor(e .* fx .* mu);
    % if any(overflow(w, WEIGHT_OUT_BITS))
    %     overflow_count = overflow_count + 1;
    % end
    % w = wrap(w, WEIGHT_OUT_BITS);
end
overflow_count %[output:71b00212]
figure;  %[output:0a435241]
plot(e_arr);  %[output:0a435241]
title("Error"); %[output:0a435241]
xlabel("Sample"); %[output:0a435241]
ylabel("Amplitude"); %[output:0a435241]
ylim([min(e_arr), max(e_arr)]); %[output:0a435241]

figure;  %[output:5069f3a5]
subplot(2, 1, 1); %[output:5069f3a5]
plot(y);      %[output:5069f3a5]
title("Anti Noise"); %[output:5069f3a5]
xlabel("Sample"); %[output:5069f3a5]
ylabel("Amplitude"); %[output:5069f3a5]
ylim([-2000, 2000]); %[output:5069f3a5]

subplot(2, 1, 2); %[output:5069f3a5]
plot(x); %[output:5069f3a5]
title("Input Noise"); %[output:5069f3a5]
xlabel("Sample"); %[output:5069f3a5]
ylabel("Amplitude"); %[output:5069f3a5]
ylim([-2000, 2000]); %[output:5069f3a5]
    

