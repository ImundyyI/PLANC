clear;
close all;
clc;


L = 10000;
F = [200, 400, 2000, 12500];
Fs = 48.8 * 10^3;

t_s = numerictype(1, 18, 0);

% I just superpositioned 3 sins of different freq, and hten a random signal
% to make it harder for the system.
% x = sin(F(1) / Fs * 2 * pi .* (1:L)) + sin(F(2) / Fs * 2 * pi .* (1:L)) + sin(F(3) / Fs * 2 * pi .* (1:L)) + rand(1, L) * 0.5;
x = 1000 * sin(F(4) / Fs * 2 * pi .* (1:L));
t = 1:L;

% error that the loop below will change for the n + 1th step.
e = 0;
% TODO: change this to the actual secondary path estimate. RN this assumes
% that there is no secondary path transfer function (assumes anti-noise has instant
% propagation time, in reality this is not true it is delayed).
s = [-94, -17, 48, 29, -22, -32, -12, -7, -33, -58, -39, 0, 15, 2, -32, -59, -26, 25, 0, -49, -50, -43, -43, -27, -22, -43, -52, -36, -15, -4, -16, -31, -21, 10, 27, 15, 2, -11, -24, -31, -49, -63, -29, -8, -14, 35, -272, -1747, -4033, -5886, -7972, -9284, -4379, 3764, 3225, -3884, -4617, 178, 1893, 1288, 3668, 7922, 5252, -6413, -13314, -7797, -1396, -2469, -4173, 1181, 9403, 10417, 6039, 4712, 3178, -767, 786, 4564, -1405, -10540, -7186, 2805, 6003, 5037, 4682, 6006, 7769, 3413, -2052, 692, 3936, 994, -4085, -10333, -17697, -17583, -2188, 15279, 15075, 2354, -3057, 3814, 7118, -3801, -13744, -8698, -316, -2865, -10494, -8327, 6249, 17801, 12124, -424, -1157, 6369, 8851, 3709, -7009, -14846, -6957, 9743, 14483, 7016, 3843, 9136, 12317, 4946, -6945, -8566, 1545, 6982, -148, -8255, -7439, 1681, 9867, 3341, -11366, -9888, 7428, 14167, 765, -12618, -6583, 7331, 4391, -9384, -10799, -2458, 608, -1027, -222, 4417, 7818, 4344, -1979, -2652, 2657, 5271, -978, -6466, 234, 9133, 5408, -4750, -6820, -56, 4710, -225, -7762, -4663, 4904, 7132, 4328, 4863, 5822, 1311, -7720, -12125, -6649, 83, 2752, 5635, 6865, 3287, -1023, -2442, 1659, 7623, 1627, -12231, -10387, 4762, 8579, -1631, -9821, -7831, 49, 3393, -719, -2619, 756, 2602, 2968, 2647, -937, -2582, -528, -2766, -7948, -7180, -797, 4871, 5032, 1104, 2270, 8753, 7250, -2850, -6538, -2025, -396, -3177, -4976, -3129, 1192, 2443, 488, 1592, 3654, 1700, -604, -452, 653, 1688, -567, -5389, -5357, -838, 659, -2094, -5115, -3704, 2632, 5799, 2884, 2740, 6557, 5159, -1890, -6609, -4811, 334, 870, -4038, -5726, -1921, 1594, 2638, 3056, 3372, 1846, -1682, -3050, -72, 1886, -1363, -4510, -2751, -493, -1595, -3648, -3388, 1331, 7467, 7013, 664, -1600, 1995, 3186, -1235, -6033, -6172, -2052, 1584, 1800, 1037, 2494, 4792, 4319, 1752, 69, -998, -1937, -2746, -4905, -5903, -1205, 5068, 4914, -646, -4026, -939, 4286, 2664, -4480, -5307, 1776, 5718, 1845, -2951, -2374, 1299, 1948, -1271, -2658, 73, 1980, 1073, 204, 102, 296, 793, 903, 700, 961, 438, -2110, -2988, 440, 2178, -1525, -3849, -443, 3399, 2890, -683, -2466, 831, 4393, 2112, -1410, -535, 227, -2264, -3134, -6, 2782, 1306, -1629, -555, 2967, 3070, 74, -1176, 229, 1154, -341, -2625, -2491, -57, 1065, 16, -1343, -2553, -2388, 349, 2724, 1939, -298, -792, 1259, 2844, 892, -2358, -2423, -36, 199, -1672, -851, 3020, 4522, 1317, -2079, -1267, 1104, 185, -2187, -1725, 54, 235, -100, 367, 621, -594, -2748, -3157, -222, 2552, 960, -2168, -1425, 2048, 3047, 374, -2064, -1369, 432, 565, -100, 157, 442, -384, -1083, -336, 1274, 2457, 1982, 170, -409, 189, -1087, -2721, -1207, 968, 316, -1710, -2170, -127, 2033, 1212, -1073, -1277, 107, 842, 779, 142, -1009, -1352, -200, 943, 828, 228, 477, 1624, 1899, 174, -1132, 277, 1741, 253, -1837, -1694, -887, -961, -867, -209, 276, 175, -430, -148, 1754, 2541, 674, -696, 45, 225, -1203, -2157, -1674, -589, 148, 84, 216, 1685, 2816, 1663, 277, 978, 1550, -260, -2388, -2387, -700, 233, -915, -1663, -195, 812, 88, 35, 1035, 1125, 79, -592, -151, 157, -734, -1249, -49, 837, -47, -288, 1201, 1507, -102, -519, 1145, 2289, 1532, 562, 1110, 2086, 1542, 228, -71, 246, 259, 705, 2060, 3024, 2429, 961, -98, -250, 760, 1890, 776, -1885, -2290, 342, 2301, 830, -2104, -2743, -642, 1215, 1104, 175, -697, -1812, -2335, -1187, 71, -318, -1333, -1712, -1109, 595, 1602, 405, -839, -473, 21, -156, -219, 112, 153, -679, -1519, -1178, -476, -419, 223, 1260, 372, -1076, -373, 698, 291, -447, -1010, -1723, -2705, -3557, -2999, -1541, -1209, -2009, -2499, -1967, -972, -531, -582, -490, -931, -2673, -3904, -2779, -877, -349, -997, -1791, -1699, -158, 1181, 467, -929, -511, 1337, 1539, -849, -2257, -513, 1321, 670, -746, -681, 647, 1522, 806, -524, -678, -13, -40, -253, 406, 1053, 802, -5, -894, -963, 376, 1719, 1106, -865, -1154, 814, 1586, -127, -1336, -329, 1222, 1257, -29, -677, -301, 58, 696, 1668, 1596, 403, -20, 1265, 2102, 156, -2466, -1537, 2188, 3086, -331, -2224, 1134, 4937, 3619, -685, -2193, 192, 2901, 3292, 1725, 186, 414, 1781, 1995, 440, -1036, -487, 1516, 2448, 1221, -588, -688, 989, 2174, 1975, 1214, 262, 16, 868, 846, -818, -1619, -117, 1452, 868, -618, -500, 1130, 1724, 237, -901, -105, 770, 497, -194, -836, -872, 89, 796, 280, -86, 883, 1811, 1216, -13, -352, -55, -190, -657, -612, 224, 850, -197, -1771, -999, 1504, 2346, 691, -1194, -1280, 92, 1215, 1295, 574, -555, -1322, -942, 82, 335, -270, -356, 188, 126, -384, -316, 45, -57, -629, -1151, -1225, -1447, -2107, -1859, -182, 1331, 1190, -296, -1471, -1384, -548, 243, 279, -479, -749, 7, 546, 116, -927, -1746, -1238, 103, 562, 59, -438, -532, -109, 493, 486, -469, -1403, -792, 673, 753, -211, -429, -277, -665, -1069, -725, 299, 1023, 712, -209, -1045, -1282, -725, -155, -296, -785, -992, -610, -35, -104, -575, -551, -122, 451, 1291, 1347, -510, -2649, -2299, 152, 1380, 133, -1077, -508, 365, 47, -710, -781, -539, -426, 184, 1238, 1710, 1256, 197, -814, -996, -574, -212, 217, 797, 1062, 781, 276, 118, 290, -13, -785, -684, 675, 1649, 862, -764, -1370, -603, 463, 934, 715, 233, 167, 773, 1142, 382, -710, -805, -63, 422, 246, -140, -362, -318, 106, 485, 381, 364, 603, 428, -4, -203, -302, -226, 376, 1158, 1128, 180, -490, -228, 388, 630, 298, 106, 843, 1639, 1138, -197, -1136, -1377, -1082, -440, 248, 799, 1018, 817, 742, 1060, 771, -545, -1409, -939, -334, -360, -36, 839, 852, -63, -415, -144, -228, -491, -271, 141, -120, -965, -1009, 89, 489, -603, -1222, -241, 760, 486, -461, -969, -534, 333, 670, 371, 25, -221, -506, -601, -392, -302, -421, -64, 966, 1571, 758, -802, -1517, -892, 38, 211, -142, -83, 247, 15, -374, -242, -113, -284, -260, 68, 426, 582, 334, -360, -1210, -1552, -1036, -255, 203, 493, 716, 690, 458, 142, -137, -285, -507, -668, -229, 401, 509, 427, 480, 535, 507, 130, -567, -915, -467, 466, 1101, 953, 288, -251, -196, 201, 147, -268, -212, 166, 235, 212, 358, 496, 559, 510, 241, -143, -240, 159, 487, 176, -268, -63, 311, -128, -787, -503, 87, -129, -562, -372, -54, -294, -798, -596, 530, 1128, 101, -1281, -1284, -271, 160, -277, -523, -245];
s_num = length(s);

% register containing weights.
w = zeros(1, 32);
w_num = length(w);

% shift registers to maintain x[n], x[n - 1], x[n - 2] etc.
x_buff = zeros(1, max(w_num, s_num));
y_buff = zeros(1, s_num);
% filtered x. this needs to be the same size as the amount of weights.
fx = zeros(1, w_num);

% step size for the error gradient. keeping at -67 for now
mu = 2^(-67);

% mu = 2^(-10)
y = zeros(1, L);
e_arr = zeros(1, L);
for n = 1:L
    % shift history buffer to make room for new sample.
    x_buff(2:end) = x_buff(1:end-1);
    % load newest sample into the history buffer.
    x_buff(1) = x(n);
    
    % convolve secondary path estimate with input to get filtered ref
    % sample.
    filteredX = sum(x_buff(1:s_num) .* s);

    % update rolling buffer tracking history of fx.
    fx(2:end) = fx(1:end-1);
    fx(1) = filteredX;

    y(n) = sum(x_buff(1:w_num) .* w);
    % we need to maintain y history in simulation since the secondary path
    % acts as a filter aswell. I believe in practice we dont have to do
    % anything surrounding this.
    y_buff(2:end) = y_buff(1:end-1);
    y_buff(1) = y(n);
    
    % apply secondary path to anti-noise y cuz it has to travel through it.
    ys = sum(y_buff .* s);

    % error. 
    e = x(n) + ys;
    e_arr(n) = e;

    % update weighting.
    w = w - mu .* e .* fx;

end

figure; %[output:14f3d346]
plot(y); %[output:14f3d346]
hold on; %[output:14f3d346]
plot (x) %[output:14f3d346]
title("X and Y signals per sample") %[output:14f3d346]
xlabel("Sample") %[output:14f3d346]
ylabel("Amplitude") %[output:14f3d346]
legend("Anti-Noise", "Reference") %[output:14f3d346]
hold off; %[output:14f3d346]

figure; %[output:966bd626]
plot(e_arr); %[output:966bd626]
title("Error Value over time") %[output:966bd626]
xlabel("Sample") %[output:966bd626]
ylabel("Amplitude") %[output:966bd626]
f = [200 400 2000];
S = abs(freqz(s, 1, f, Fs));      % vector of frequencies, so it's read as Hz
fprintf('|S(%d Hz)| = %.1f\n', [f; S]); %[output:725e3a10]
fprintf('max|e| = %.3g, any NaN/Inf: %d\n', max(abs(e_arr)), any(~isfinite(e_arr))); %[output:68178dc2]

